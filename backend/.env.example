DATABASE_URL=sqlite:///./bidguard.db
UPLOAD_DIR=../data/uploads
CORS_ORIGINS=http://localhost:3000

# Local deterministic defaults need no API keys and are used by tests.
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=local-hash-v1
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_DIMENSION=64
EMBEDDING_TIMEOUT_SECONDS=30
# Set the current provider price to estimate experiment cost; 0 disables estimation.
EMBEDDING_INPUT_COST_PER_MILLION_TOKENS=0
LLM_PROVIDER=local_fake
LLM_MODEL=local-fake-v1
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_TEMPERATURE=0
LLM_TIMEOUT_SECONDS=30
LLM_INPUT_COST_PER_MILLION_TOKENS=0
# Optional; when omitted, cached input uses the normal input rate.
# LLM_CACHED_INPUT_COST_PER_MILLION_TOKENS=0
LLM_OUTPUT_COST_PER_MILLION_TOKENS=0

# Optional fallback values for OpenAI-compatible providers.
# Keep real keys in an untracked .env file or exported shell environment only.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini
